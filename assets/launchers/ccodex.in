#!@PINNED_BASH@
# ccodex — the Agentic SDLC operator dispatcher for the USE surface.
#
# Installed by scripts/install_operator_tools.py into an existing user-owned PATH directory.
# @CANONICAL_ROOT@ is substituted at install time with the repository root this command was
# installed from; @CANONICAL_LAUNCHER@ with the supervised opencodex launcher inside it.
#
# THE SHEBANG IS A PIN, NOT A LITERAL, because bash does not live at one absolute path on every
# supported host: Linux ships /usr/bin/bash (with /bin/bash usually a merged-usr link to it) and
# macOS ships only /bin/bash. A hard-coded `#!/usr/bin/bash` therefore installed a command that
# reported `0 installed` on macOS and then failed at every later exec with ENOENT on the
# INTERPRETER -- which CPython reports against the script path, so the operator saw
# "no such file or directory: .../bin/ccodex" for a file that plainly existed. The installer
# resolves the interpreter from a closed list of absolute system paths and renders it here, and it
# is now the only renderer: the candidate-execution bridge that used to substitute a digest-verified
# linux-x64 `trusted_bash.path` was deleted with the acquisition engine, along with the policy that
# pinned it. A shebang cannot be quoted, so the resolver admits no interpreter path containing
# whitespace.
#
# The grammar below is deliberately bash-3.2 compatible for the same reason: macOS carries no
# newer bash, so a bash-4-only construct here would be a dead command on a claimed platform.
#
# WHY ONE DISPATCHER RATHER THAN N COMMANDS (ADR-0010). There are 36 mise tasks and most are
# repository maintenance -- test, validate, check, secrets, self-test, mermaid:*, hooks:install.
# Those belong to someone working ON this repo, not to an operator USING what it installed, and
# putting them on PATH would present a maintenance surface as a product surface. The USE surface
# is small and stable, so it is reached through subcommands of one owned command: one file to own,
# refresh, and uninstall, one place where a new verb appears, and no PATH namespace land-grab.
# The alternative -- a dozen named commands -- loses on exactly that: every added verb becomes a
# new PATH entry, a new ownership record, and a new collision risk against a name the operator
# may already use.
#
# RUNTIME DEPENDENCIES, stated plainly because they are the operator's real question:
#   * THE REPOSITORY CLONE IS REQUIRED. Every route resolves its implementation and pinned tools
#     from @CANONICAL_ROOT@. This command is a thin, owned entry point, NOT a self-contained copy of
#     the bundle, so if that directory is moved or deleted every route fails with the named error
#     below rather than misbehaving. Launch routes restore the caller's workspace before Claude Code
#     starts; the distribution root selects code and tools, not the project Claude works on. The
#     root is resolved at run time (env override, then the installed default), not baked into an
#     exec line, so a managed clone at a stable path can be pointed at without reinstalling this file.
#   * Launch-time mise activation is NOT required. Installation binds the exact pinned `ocx`,
#     `jq`, and `uv` executables below; daily routes call those paths directly and preserve the
#     caller cwd. Re-run the explicit operator-tools install after a reviewed toolchain upgrade to
#     refresh them.
set -euo pipefail

# Installed operator tools always render `false`, preserving their existing dispatch behavior.
# NOTHING SHIPPED RENDERS `true` any more: the candidate-execution bridge that did was deleted with
# the acquisition engine, so this branch is reachable only from the lifecycle-grammar and
# recover-apply test modules, which render the literal themselves. The branch and its closed
# read-only grammar are retained rather than removed because they remain the exact shape a future
# candidate surface must render, and those two suites still hold it to it. Candidate mode is
# intentionally self-relative and exits before any installed route, root override, tool binding, or
# gateway code can run.
candidate_readonly_profile=@CANDIDATE_READONLY_PROFILE@
if [ "$candidate_readonly_profile" = true ]; then
  # This allowlist is closed by construction, so every mutating form -- `sdlc install --host claude`,
  # `sdlc update`, `sdlc uninstall`, and `sdlc recover --apply <plan-sha256>` -- is refused here
  # without being named: adding a verb or a form to the grammar below never widens what a candidate
  # projection admits. The reader refuses them a second time if it is invoked directly with the
  # candidate flag.
  case "$#:$*" in
    "2:sdlc inspect"|"3:sdlc inspect --json"|\
    "2:sdlc status"|"3:sdlc status --json"|\
    "2:sdlc doctor"|"3:sdlc doctor --json"|\
    "3:sdlc recover --dry-run"|"4:sdlc recover --dry-run --json") ;;
    *)
      printf 'error: candidate ccodex admits only read-only sdlc inspection\n' >&2
      exit 2
      ;;
  esac
  candidate_bin=${BASH_SOURCE[0]%/*}
  cd -P -- "$candidate_bin/.." || {
    printf 'error: candidate ccodex cannot resolve its physical projection root\n' >&2
    exit 3
  }
  candidate_root=$PWD
  unset AGENTIC_SDLC_ROOT PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONBREAKPOINT \
    UV_CONFIG_FILE UV_CACHE_DIR UV_PROJECT_ENVIRONMENT MISE_CONFIG_FILE MISE_CONFIG_ROOT \
    HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy \
    CCODEX_CANDIDATE_ADMISSION_FD
  exec "$candidate_root/runtime/python/bin/python3.12" -I -B \
    "$candidate_root/scripts/ccodex_sdlc.py" --candidate-observation-v1 "${@:2}"
fi

# Repository root. AGENTIC_SDLC_ROOT wins, so an operator or a managed-clone installer can move
# the checkout without reinstalling this command; the install-time path is the fallback.
#
# The default is assigned on its own line rather than inside a `${VAR:-@SUBST@}` expansion: the
# installer shell-quotes the substituted path so a root containing a space still parses, and
# quotes inside a `:-` word would be taken literally.
installed_root=@CANONICAL_ROOT@
installed_ocx=@PINNED_OCX@
installed_jq=@PINNED_JQ@
installed_uv=@PINNED_UV@
installed_sdlc_python=@PINNED_SDLC_PYTHON@
root="${AGENTIC_SDLC_ROOT:-$installed_root}"
launcher="$root/scripts/opencodex-claude.sh"
export AGENTIC_SDLC_OCX="$installed_ocx"
export AGENTIC_SDLC_JQ="$installed_jq"

usage() {
  cat <<EOF
usage: ccodex <command> [args...]

Gateway plane -- one session, both catalogs (\`ccodex ocx <verb>\` is the long form):
  ensure                      Ensure the gateway is healthy without launching Claude Code.
  launch [--yolo] [args...]  Ensure the gateway is healthy, then launch Claude Code through it
                              with your OWN ~/.claude login. Native claude models pass through
                              to Anthropic on your subscription; gateway models route to their
                              own providers -- both in one session. Select any catalog model
                              with --model. --yolo explicitly bypasses permission checks and is
                              unsafe outside an isolated, disposable environment.
  ultracode [--yolo] [args...] Same fail-closed launch path with session Ultracode; --yolo
                              explicitly bypasses permission checks with the same warning.
  status                      Gateway supervision, configured-vs-live providers, and whether
                              anything would silently defeat the gateway route.
  restart                     Stop cleanly, then ensure the gateway is back up.

Providers and models (what a launched session can actually pick):
  providers                   Configured providers, and which are LIVE in the running gateway.
  models                      The running gateway's flat live catalog. Muse models appear here
                              as ordinary namespaced entries, not as a separate plane.
  set-fast-model [<id|->]     Select Claude Code's Haiku/background small-fast model from current
                              Claude families and the live OCX catalog, or set an exact id; - clears.
  configure [args...]         Reviewed provider configuration. Adding a provider:
                              ccodex configure provider add muse --adapter openai-responses \\
                                --base-url https://api.meta.ai/v1 --default-model muse-spark-1.2

Installed-bundle lifecycle:
  bundle <install|status|uninstall>
  libraries <list|status|install|migrate|uninstall> [args...]
  statusline <status|activate|deactivate> [args...]

Checkout-development evidence (read-only, no gateway or lifecycle effects):
  sdlc <inspect|status|doctor> [--json]
  sdlc recover --dry-run [--json]
                              Proposal-only. Renders the sha256 of the exact plan it derived.

Checkout-development lifecycle (mutating verbs; each is admitted or refused by its own module):
  sdlc install --host claude   Explicit host, no default and no wildcard.
  sdlc update
  sdlc uninstall
  sdlc recover --apply <plan-sha256>
                              The approval IS the digest: it re-derives the plan from verified
                              journal and receipt state and refuses by name when the re-derived
                              digest differs, the evidence does not verify, or nothing is
                              recoverable. Preserved state is named, never overwritten.

  version                     Report this command's resolved repository root and dependencies.

Help is never a side-effecting operation. \`ccodex <verb> --help\` prints that verb's own help
and runs nothing -- it starts no gateway and writes no session state. To reach the help of the
tool BEHIND a launch verb, end this command's options with \`--\`:
  ccodex launch -- --help     Claude Code's own help, through a prepared session

Maintenance tasks (test, validate, check, secrets, mermaid, hooks) are deliberately absent:
they belong to working ON the repository, not to using what it installed. Run them with
\`mise run <task>\` inside $root

exit codes: 0 ok - 1 failure - 2 usage - 3 refused (a boundary declined the operation before any
effect) - 4 admitted partial or unknown effect (\`sdlc\` lifecycle verbs only)
EOF
}

# Every route resolves code from the clone, so its absence is reported once, by name, rather than
# surfacing as an obscure "no such file" from whichever route was attempted.
require_root() {
  if [ ! -d "$root" ]; then
    printf 'error: the agentic-sdlc repository root is missing: %s\n' "$root" >&2
    printf 'This command is a thin entry point, not a self-contained copy of the bundle.\n' >&2
    printf 'Point it at an existing checkout with AGENTIC_SDLC_ROOT=/path/to/agentic-sdlc,\n' >&2
    printf 'or reinstall the operator tools from the checkout you want it to use.\n' >&2
    exit 1
  fi
}

require_launcher() {
  require_root
  [ -f "$launcher" ] || {
    printf 'error: the supervised launcher is missing: %s\n' "$launcher" >&2
    exit 1
  }
}

# uv-backed Python route. The executable is bound during operator-tools installation just like ocx
# and jq, so caller PATH cannot replace the reviewed runtime or make an installed route disappear.
run_python() {
  local script="$1"
  shift
  require_root
  [ -x "$installed_uv" ] || {
    printf 'error: the installed pinned uv executable is unavailable; refresh operator tools from the reviewed distribution\n' >&2
    exit 1
  }
  exec "$installed_uv" run --python 3.12.11 --script "$root/scripts/$script" "$@"
}

# `ccodex sdlc` intentionally does not share run_python: installation bound and verified a
# UV-managed Python 3.12.11 interpreter, and daily checkout-development commands invoke it
# directly with isolated, bytecode-free flags. That keeps this entry away from UV, Mise, OCX,
# the gateway, ambient Python, and their corresponding network or lifecycle surfaces.
#
# The same entry carries the read-only verbs AND the three mutating lifecycle verbs, because the
# closed grammar has exactly one owner. This function adds no second grammar: it verifies the bound
# interpreter and the entry file, then forwards the argument vector unchanged. Every verb decision
# -- admit, refuse by name, or hand off to a per-verb module -- belongs to scripts/ccodex_sdlc.py.
run_sdlc_python() {
  require_root
  [ -x "$installed_sdlc_python" ] || {
    printf 'error: the installed ccodex sdlc Python 3.12.11 interpreter is unavailable; refresh operator tools from the reviewed distribution\n' >&2
    exit 3
  }
  [ -f "$root/scripts/ccodex_sdlc.py" ] || {
    printf 'error: the checkout-development sdlc entry is unavailable in this distribution\n' >&2
    exit 3
  }
  exec "$installed_sdlc_python" -I -B "$root/scripts/ccodex_sdlc.py" "$@"
}

# Pinned ocx passthrough. Read-only catalog routes and the explicitly named fast-model mutation
# reuse OpenCodex's own verbs rather than creating a second reader or configuration store that
# could disagree with the gateway.
require_ocx() {
  require_root
  [ -x "$AGENTIC_SDLC_OCX" ] || {
    printf 'error: the installed pinned ocx executable is unavailable; refresh operator tools from the reviewed distribution\n' >&2
    exit 1
  }
}

require_jq() {
  require_root
  [ -x "$AGENTIC_SDLC_JQ" ] || {
    printf 'error: the installed pinned jq executable is unavailable; refresh operator tools from the reviewed distribution\n' >&2
    exit 1
  }
}

run_ocx() {
  require_ocx
  exec "$AGENTIC_SDLC_OCX" "$@"
}

set_fast_model_help() {
  cat <<'EOF'
usage: ccodex set-fast-model [<exact-model-id|->]

With no value, select from Claude Code's current Sonnet/Opus/Fable families or the
live OCX catalog; clear the override to use the normal subscription Haiku slot. With
one value, set that exact Claude or routed id without prompting; pass - to clear it.

This is not the Auto mode permission classifier. A selection persists operator
configuration; help and cancellation do not.
EOF
}

select_fast_model() {
  local catalog lines choice selected index=1
  require_ocx
  require_jq
  catalog="$("$AGENTIC_SDLC_OCX" models live --json 2>/dev/null)" || {
    printf 'error: cannot read the live OCX catalog; no selection was written\n' >&2
    printf 'Start or repair the gateway, then run `ccodex set-fast-model` again.\n' >&2
    return 1
  }
  lines="$(printf '%s' "$catalog" | "$AGENTIC_SDLC_JQ" -r '
    .[] | select(.disabled != true) |
    [.namespaced, (if .native == true then "native OCX" else "routed via " + .provider end)] |
    @tsv
  ')" || {
    printf 'error: the live OCX catalog could not be parsed; no selection was written\n' >&2
    return 1
  }
  [ -n "$lines" ] || {
    printf 'error: the live OCX catalog is empty; no selection was written\n' >&2
    return 1
  }

  printf 'Claude Code families (entitlement checked when used):\n'
  for selected in sonnet opus fable; do
    printf '  %d) %-34s %s\n' "$index" "$selected" 'Claude family alias'
    index=$((index + 1))
  done
  printf '\nLive OCX catalog:\n'
  while IFS="$(printf '\t')" read -r selected source; do
    printf '  %d) %-34s %s\n' "$index" "$selected" "$source"
    index=$((index + 1))
  done <<EOF
$lines
EOF
  printf '  %d) %-34s %s\n' "$index" '-' 'clear current selection'
  printf '\nSelect 1-%d (q to cancel): ' "$index"
  IFS= read -r choice || choice=q
  case "$choice" in
    q|Q|'') printf 'selection cancelled; no configuration was written\n' >&2; return 3 ;;
    *[!0-9]*|0) printf 'error: invalid selection; no configuration was written\n' >&2; return 2 ;;
  esac
  [ "$choice" -le "$index" ] || {
    printf 'error: invalid selection; no configuration was written\n' >&2
    return 2
  }
  if [ "$choice" -le 3 ]; then
    case "$choice" in
      1) selected=sonnet ;;
      2) selected=opus ;;
      3) selected=fable ;;
    esac
  elif [ "$choice" -eq "$index" ]; then
    selected=-
  else
    selected="$(printf '%s\n' "$lines" | cut -f1 | grep -n '^' | grep "^$((choice - 3)):" | cut -d: -f2-)"
  fi
  run_ocx claude config set --small-fast-model "$selected"
}

# Long-form verb name for the supervised launcher, or empty for a spelling it does not serve.
# `ultracode` is this command's operator-facing spelling of the launcher's `launch-ultracode`.
launcher_verb() {
  case "$1" in
    ensure|launch|status|restart|configure|launch-ultracode) printf '%s' "$1" ;;
    ultracode) printf 'launch-ultracode' ;;
    *) return 1 ;;
  esac
}

# A sub-dispatcher's help request must not be an error.
#
# `ccodex bundle --help` used to print `error: ccodex bundle needs install|status|uninstall` on
# stderr and exit 2 -- the same defect class fixed for the launch verbs on 2026-08-07, surviving
# in the routes that fix did not touch. A help request answered with a usage error is a defect
# regardless of how good the text underneath it is. A BARE verb still exits 2, because that is a
# genuine invocation error rather than a question.
sub_dispatch_help() {
  printf 'usage: ccodex %s <%s>\n\n' "$1" "$2"
  printf 'Run `ccodex --help` for what each does, or pass a subcommand'"'"'s own --help.\n'
  exit 0
}

route="${1:-}"
case "$route" in
  ensure|launch|ultracode|status|restart|configure)
    require_launcher
    verb="$(launcher_verb "$route")"
    shift
    # Verb-level help and the `--` escape are BOTH the launcher's decisions, not this file's: it
    # owns the per-verb text and the forwarding rule, so duplicating either here would create a
    # second help surface that can drift out of agreement with the one the launcher prints.
    exec "$launcher" "$verb" "$@"
    ;;
  # Explicit long form. Kept alongside the shorthand above because `ccodex ocx launch` is what a
  # reader guesses from `ccodex muse ...`-shaped documentation, and silently failing a reasonable
  # guess is worse than accepting both spellings.
  ocx)
    require_launcher
    shift
    verb="${1:-}"
    # `ccodex ocx --help` is a reasonable spelling of "explain the ocx routes" and used to error
    # with `unknown ccodex ocx verb: --help` and exit 2. A help request answered with an error is
    # a defect regardless of the usage text printed underneath it, so the help spellings are
    # handled before the verb table rather than falling through it.
    case "$verb" in
      -h|--help|help) usage; exit 0 ;;
      "") printf 'error: ccodex ocx needs a verb (ensure|launch|ultracode|status|restart|configure)\n\n' >&2; usage >&2; exit 2 ;;
    esac
    shift
    resolved="$(launcher_verb "$verb")" \
      || { printf 'error: unknown ccodex ocx verb: %s\n\n' "$verb" >&2; usage >&2; exit 2 ; }
    exec "$launcher" "$resolved" "$@"
    ;;
  providers)
    shift
    run_ocx provider list "$@"
    ;;
  set-fast-model)
    shift
    case "${1:-}" in
      -h|--help|help) [ "$#" -eq 1 ] || { printf 'usage: ccodex set-fast-model [<exact-model-id|->]\n' >&2; exit 2; }; set_fast_model_help; exit 0 ;;
    esac
    [ "$#" -le 1 ] || { printf 'usage: ccodex set-fast-model [<exact-model-id|->]\n' >&2; exit 2; }
    if [ "$#" -eq 0 ]; then
      require_root
      select_fast_model
    else
      run_ocx claude config set --small-fast-model "$1"
    fi
    ;;
  # The LIVE catalog, read from the running gateway's own `GET /v1/models` -- deliberately NOT
  # `ocx models list`, which reports the CONFIGURED models from the config file. The two
  # disagree, and the disagreement is the whole point: verified 2026-08-07, `ocx models list`
  # showed one muse entry while the running gateway served ten ids (seven gpt plus three
  # namespaced muse). Only the live catalog answers "what can a launched session pick", so a
  # configured-only view here would be a confidently wrong answer to the operator's question.
  models)
    shift
    require_ocx
    require_jq
    port="$("$AGENTIC_SDLC_OCX" config get port 2>/dev/null | tr -d '[:space:]' | grep -E '^[0-9]+$' || true)"
    if [ -z "$port" ] || ! command -v curl >/dev/null 2>&1; then
      printf 'error: cannot read the live catalog (no configured port, or curl is unavailable)\n' >&2
      printf 'Configured (NOT proof of what is served): ccodex providers\n' >&2
      exit 1
    fi
    catalog="$(curl -fsS --max-time 6 "http://127.0.0.1:${port}/v1/models" 2>/dev/null || true)"
    if [ -z "$catalog" ]; then
      printf 'error: the gateway at 127.0.0.1:%s did not serve a catalog. It may be down.\n' "$port" >&2
      printf 'Start it and re-check:  ccodex status\n' >&2
      exit 1
    fi
    printf 'live catalog served by the gateway at 127.0.0.1:%s\n' "$port"
    printf '(any id below can be selected with `ccodex launch --model <id>` or the /model picker)\n\n'
    printf '%s' "$catalog" | "$AGENTIC_SDLC_JQ" -r '(.data // []) | .[] | select(.id != null) | "  " + .id'
    printf '\nA namespaced id (provider/model) is an ordinary catalog entry: a provider such as\n'
    printf 'muse is one row in `ccodex providers`, never a separate plane or launcher.\n'
    printf '\nThis is reachability, not authorization, and it is not a capability claim.\n'
    ;;
  bundle)
    shift
    verb="${1:-}"
    case "$verb" in
      install|status|uninstall) shift; run_python install_skill_bundle.py "$verb" "$@" ;;
      -h|--help|help) sub_dispatch_help bundle 'install|status|uninstall' ;;
      *) printf 'error: ccodex bundle needs install|status|uninstall\n' >&2; exit 2 ;;
    esac
    ;;
  libraries)
    shift
    verb="${1:-}"
    case "$verb" in
      list|status|install|migrate|uninstall) shift; run_python install_external_libraries.py "$verb" "$@" ;;
      -h|--help|help) sub_dispatch_help libraries 'list|status|install|migrate|uninstall' ;;
      *) printf 'error: ccodex libraries needs list|status|install|migrate|uninstall\n' >&2; exit 2 ;;
    esac
    ;;
  statusline)
    shift
    verb="${1:-}"
    case "$verb" in
      status|activate|deactivate) shift; run_python manage_claude_statusline.py "$verb" "$@" ;;
      -h|--help|help) sub_dispatch_help statusline 'status|activate|deactivate' ;;
      *) printf 'error: ccodex statusline needs status|activate|deactivate\n' >&2; exit 2 ;;
    esac
    ;;
  sdlc)
    shift
    # Readers and the three mutating lifecycle verbs take the same route on purpose. A second
    # grammar here could disagree with the reader's closed one, and a verb this dispatcher did not
    # know would then be refused with the wrong reason. `install --host claude`, `update`, and
    # `uninstall` are therefore forwarded verbatim, and the reader refuses them by name -- exit 3,
    # before any effect -- while their per-verb modules are absent from this distribution.
    run_sdlc_python "$@"
    ;;
  version)
    printf 'ccodex (agentic-sdlc operator dispatcher)\n'
    printf '  repository root : %s%s\n' "$root" "$([ -d "$root" ] || printf ' (MISSING)')"
    printf '  root source     : %s\n' "$([ -n "${AGENTIC_SDLC_ROOT:-}" ] && printf 'AGENTIC_SDLC_ROOT' || printf 'install-time default')"
    printf '  pinned ocx             : %s%s\n' "$AGENTIC_SDLC_OCX" "$([ -x "$AGENTIC_SDLC_OCX" ] || printf ' (MISSING)')"
    printf '  pinned jq              : %s%s\n' "$AGENTIC_SDLC_JQ" "$([ -x "$AGENTIC_SDLC_JQ" ] || printf ' (MISSING)')"
    printf '  pinned uv              : %s%s\n' "$installed_uv" "$([ -x "$installed_uv" ] || printf ' (MISSING)')"
    printf '  pinned sdlc Python     : %s%s\n' "$installed_sdlc_python" "$([ -x "$installed_sdlc_python" ] || printf ' (MISSING)')"
    printf '\nThe clone is required: this command executes code inside the root above.\n'
    ;;
  -h|--help|help) usage ;;
  "") usage >&2; exit 2 ;;
  *) printf 'error: unknown command %s\n\n' "$route" >&2; usage >&2; exit 2 ;;
esac
