{
  "schema_version": "release-smoke/v1",
  "cases": [
    {
      "id": "version-answers-tool-free-from-the-extracted-tree",
      "argv": [
        "version"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "toolfree",
      "expect_exit": 0,
      "expect_stdout_present": [
        "{tree}",
        "self-located"
      ]
    },
    {
      "id": "help-answers-tool-free-from-the-extracted-tree",
      "argv": [
        "--help"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "toolfree",
      "expect_exit": 0,
      "expect_stdout_present": [
        "usage: ccodex <command>"
      ]
    },
    {
      "id": "an-unknown-dispatcher-command-is-a-tool-free-usage-error",
      "argv": [
        "frobnicate"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "toolfree",
      "expect_exit": 2,
      "expect_stderr_present": [
        "unknown command frobnicate"
      ]
    },
    {
      "id": "status-json-is-admitted",
      "argv": [
        "status",
        "--scope",
        "user",
        "--agent",
        "claude",
        "--json"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "checkout.plane": "checkout-development",
        "command.verb": "status",
        "runtime.isolated": true,
        "runtime.state": "admitted",
        "runtime.version": "3.12.11",
        "overall.exit_class": "ok"
      },
      "forbid_finding_codes": [
        "runtime-admission-refused"
      ]
    },
    {
      "id": "doctor-json-is-admitted",
      "argv": [
        "doctor",
        "--json"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "checkout.plane": "checkout-development",
        "command.verb": "doctor",
        "runtime.isolated": true,
        "runtime.state": "admitted",
        "runtime.version": "3.12.11",
        "overall.exit_class": "ok"
      },
      "forbid_finding_codes": [
        "runtime-admission-refused"
      ]
    },
    {
      "id": "recover-dry-run-json-is-admitted-and-proposal-only",
      "argv": [
        "recover",
        "--dry-run",
        "--json"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "checkout.plane": "checkout-development",
        "command.verb": "recover",
        "runtime.isolated": true,
        "runtime.state": "admitted",
        "runtime.version": "3.12.11",
        "overall.exit_class": "ok",
        "command.dry_run": true,
        "recovery.effect": "none"
      },
      "forbid_finding_codes": [
        "runtime-admission-refused"
      ]
    },
    {
      "id": "the-human-render-names-the-admitted-runtime",
      "argv": [
        "status",
        "--scope",
        "user",
        "--agent",
        "claude"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_present": [
        "runtime: admitted (3.12.11, isolated=true)",
        "ccodex status:"
      ],
      "expect_stdout_absent": [
        "runtime: refused",
        "Traceback"
      ],
      "expect_stderr_present": [
        "selected plane: claude/user"
      ]
    },
    {
      "id": "a-missing-scope-selector-is-a-usage-error-naming-the-flag",
      "argv": [
        "status",
        "--agent",
        "claude"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 2,
      "expect_stderr_present": [
        "ccodex status requires an explicit --scope user|project",
        "there is no default scope"
      ],
      "expect_stderr_absent": [
        "expected direct -I -B execution",
        "Traceback"
      ]
    },
    {
      "id": "an-unadmitted-agent-is-a-usage-error-naming-the-admitted-planes",
      "argv": [
        "install",
        "--scope",
        "user",
        "--agent",
        "gemini"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 2,
      "expect_stderr_present": [
        "unsupported ccodex install agent: 'gemini'",
        "the admitted agents are claude, codex"
      ],
      "expect_stderr_absent": [
        "expected direct -I -B execution",
        "Traceback"
      ]
    },
    {
      "id": "project-scope-parses-and-is-refused-by-name-until-it-is-wired",
      "argv": [
        "install",
        "--scope",
        "project",
        "--agent",
        "claude"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 3,
      "expect_stderr_present": [
        "project-scope-not-yet-wired",
        "wave W4 of agentic-sdlc-7a2b"
      ],
      "expect_stderr_absent": [
        "expected direct -I -B execution",
        "Traceback",
        "usage: ccodex"
      ]
    },
    {
      "id": "the-retired-bundle-spelling-names-its-replacement-invocation",
      "argv": [
        "bundle",
        "install",
        "--agent",
        "claude"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "toolfree",
      "expect_exit": 2,
      "expect_stderr_present": [
        "`ccodex bundle install` is retired",
        "ccodex install --scope user --agent <claude|codex>"
      ]
    },
    {
      "id": "the-retired-sdlc-read-spelling-names-both-replacement-verbs",
      "argv": [
        "sdlc",
        "status"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "toolfree",
      "expect_exit": 2,
      "expect_stderr_present": [
        "`ccodex sdlc status` is retired",
        "ccodex status --scope user --agent <claude|codex>",
        "ccodex doctor"
      ]
    },
    {
      "id": "libraries-list-still-reaches-the-shared-uv-runner",
      "argv": [
        "libraries",
        "list"
      ],
      "platforms": [
        "Darwin",
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_present": [
        "External skill libraries reachable through their own front doors."
      ],
      "expect_stdout_absent": [
        "Traceback",
        "error:"
      ]
    },
    {
      "id": "install-refuses-before-effect-on-linux",
      "argv": [
        "install",
        "--scope",
        "user",
        "--agent",
        "claude"
      ],
      "platforms": [
        "Linux"
      ],
      "environment": "host",
      "expect_exit": 3,
      "expect_stderr_present": [
        "refused before any effect",
        "no acquired candidate is available"
      ],
      "expect_stderr_absent": [
        "expected direct -I -B execution"
      ]
    },
    {
      "id": "install-refuses-by-name-off-linux",
      "argv": [
        "install",
        "--scope",
        "user",
        "--agent",
        "claude"
      ],
      "platforms": [
        "Darwin"
      ],
      "environment": "host",
      "expect_exit": 3,
      "expect_stderr_present": [
        "refused before any effect",
        "certified only on Linux"
      ],
      "expect_stderr_absent": [
        "expected direct -I -B execution"
      ]
    }
  ]
}
