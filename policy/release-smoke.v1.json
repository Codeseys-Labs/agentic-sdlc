{
  "schema_version": "release-smoke/v1",
  "cases": [
    {
      "id": "version-answers-tool-free-from-the-extracted-tree",
      "argv": ["version"],
      "platforms": ["Darwin", "Linux"],
      "environment": "toolfree",
      "expect_exit": 0,
      "expect_stdout_present": ["{tree}", "self-located"]
    },
    {
      "id": "help-answers-tool-free-from-the-extracted-tree",
      "argv": ["--help"],
      "platforms": ["Darwin", "Linux"],
      "environment": "toolfree",
      "expect_exit": 0,
      "expect_stdout_present": ["usage: ccodex <command>"]
    },
    {
      "id": "an-unknown-dispatcher-command-is-a-tool-free-usage-error",
      "argv": ["frobnicate"],
      "platforms": ["Darwin", "Linux"],
      "environment": "toolfree",
      "expect_exit": 2,
      "expect_stderr_present": ["unknown command frobnicate"]
    },
    {
      "id": "sdlc-inspect-json-is-admitted",
      "argv": ["sdlc", "inspect", "--json"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "checkout.plane": "checkout-development",
        "command.verb": "inspect",
        "overall.exit_class": "ok",
        "runtime.isolated": true,
        "runtime.state": "admitted",
        "runtime.version": "3.12.11"
      },
      "forbid_finding_codes": ["runtime-admission-refused"]
    },
    {
      "id": "sdlc-status-json-is-admitted",
      "argv": ["sdlc", "status", "--json"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "command.verb": "status",
        "overall.exit_class": "ok",
        "runtime.isolated": true,
        "runtime.state": "admitted",
        "runtime.version": "3.12.11"
      },
      "forbid_finding_codes": ["runtime-admission-refused"]
    },
    {
      "id": "sdlc-doctor-json-is-admitted",
      "argv": ["sdlc", "doctor", "--json"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "command.verb": "doctor",
        "overall.exit_class": "ok",
        "runtime.isolated": true,
        "runtime.state": "admitted",
        "runtime.version": "3.12.11"
      },
      "forbid_finding_codes": ["runtime-admission-refused"]
    },
    {
      "id": "sdlc-recover-dry-run-json-is-admitted-and-proposal-only",
      "argv": ["sdlc", "recover", "--dry-run", "--json"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_json": {
        "command.dry_run": true,
        "command.verb": "recover",
        "recovery.effect": "none",
        "runtime.state": "admitted"
      },
      "forbid_finding_codes": ["runtime-admission-refused"]
    },
    {
      "id": "the-human-render-names-the-admitted-runtime",
      "argv": ["sdlc", "status"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_present": ["runtime: admitted (3.12.11, isolated=true)"],
      "expect_stdout_absent": ["runtime: refused", "Traceback"]
    },
    {
      "id": "an-unknown-sdlc-verb-is-a-usage-error-not-a-refusal",
      "argv": ["sdlc", "frobnicate"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 2,
      "expect_stderr_present": ["unknown ccodex sdlc verb: 'frobnicate'"],
      "expect_stderr_absent": ["expected direct -I -B execution"]
    },
    {
      "id": "bundle-status-reads-the-ledger-and-ends-with-its-terminal-line",
      "argv": ["bundle", "status"],
      "platforms": ["Darwin", "Linux"],
      "environment": "host",
      "expect_exit": 0,
      "expect_stdout_matches": ["(?m)^(?:no owned entries for this host \\(run: mise run bundle:install\\)|[0-9]+ ok, [0-9]+ conflict, [0-9]+ absent)\\s*\\Z"],
      "expect_stdout_absent": ["Traceback", "error:"],
      "expect_stderr_absent": ["Traceback"]
    },
    {
      "id": "sdlc-install-refuses-before-effect-on-linux",
      "argv": ["sdlc", "install", "--host", "claude"],
      "platforms": ["Linux"],
      "environment": "host",
      "expect_exit": 3,
      "expect_stderr_present": ["refused before any effect", "no acquired candidate is available"],
      "expect_stderr_absent": ["expected direct -I -B execution"]
    },
    {
      "id": "sdlc-install-refuses-by-name-off-linux",
      "argv": ["sdlc", "install", "--host", "claude"],
      "platforms": ["Darwin"],
      "environment": "host",
      "expect_exit": 3,
      "expect_stderr_present": ["refused before any effect", "certified only on Linux"],
      "expect_stderr_absent": ["expected direct -I -B execution"]
    }
  ]
}
